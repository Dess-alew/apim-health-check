name: Test Google Every Minute

on:
  schedule:
    - cron: "*/1 * * * *"   # runs every 1 minute
  workflow_dispatch:

jobs:
  call-google:
    runs-on: ubuntu-latest

    steps:
      - name: Call Google
        run: |
          echo "Calling Google..."
          STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://www.google.com)
          echo "HTTP Status: $STATUS"

          if [ "$STATUS" -eq 200 ]; then
            echo "Google is reachable"
          else
            echo "Google call failed"
            exit 1
          fi
